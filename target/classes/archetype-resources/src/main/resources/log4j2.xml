#set( $symbol_pound = '#' )
#set( $symbol_dollar = '$' )
#set( $symbol_escape = '\' )
<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
	<Properties>
		<Property name="CONSOLE_PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%t] %logger{40} - %msg%n</Property>
	</Properties>

	<Appenders>
		<Console name="Console" target="SYSTEM_OUT">
			<PatternLayout pattern="${symbol_dollar}{CONSOLE_PATTERN}" charset="UTF-8" />
		</Console>
	</Appenders>

	<Loggers>
		<!-- hibernate.show_sql=true 通过 org.hibernate.SQL 输出，需要 DEBUG 级别 -->
		<Logger name="org.hibernate.SQL" level="debug" additivity="false">
			<AppenderRef ref="Console" />
		</Logger>
		<Logger name="org.hibernate.orm.jdbc.bind" level="trace" additivity="false">
			<AppenderRef ref="Console" />
		</Logger>
		<Logger name="org.redisson" level="info" />

		<Root level="info">
			<AppenderRef ref="Console" />
		</Root>
	</Loggers>
</Configuration>
